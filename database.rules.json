{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null && (auth.uid === 'OWNER_UID' || root.child('rooms/' + $roomId + '/members/' + auth.uid).exists())",
        "members": {
          ".write": "auth != null && auth.uid === 'OWNER_UID'",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "requests": {
          ".write": "auth != null && auth.uid === 'OWNER_UID'",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.hasChildren(['name', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 40)"
          }
        },
        "meta": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/members/' + auth.uid).exists()"
        },
        "players": {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && (auth.uid === 'OWNER_UID' || (!data.exists() && root.child('rooms/' + $roomId + '/members/' + auth.uid).exists()))",
            "avatar": {
              ".write": "auth != null && (auth.uid === 'OWNER_UID' || root.child('rooms/' + $roomId + '/bindings/' + auth.uid).val() === $pid)",
              ".validate": "!newData.exists() || (newData.hasChild('image') && newData.child('image').isString() && newData.child('image').val().length <= 40000) || (newData.hasChild('sym') && newData.child('sym').isString() && newData.child('sym').val().length <= 24 && newData.child('bg').isString() && newData.child('bg').val().length <= 9)"
            }
          }
        },
        "history": {
          "$gameId": {
            ".write": "auth != null && (auth.uid === 'OWNER_UID' || (!data.exists() && root.child('rooms/' + $roomId + '/members/' + auth.uid).exists()))"
          }
        },
        "control": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/members/' + auth.uid).exists()"
        },
        "bindings": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || auth.uid === 'OWNER_UID')",
            ".validate": "newData.isString() && newData.val().length < 60"
          }
        },
        "game": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/members/' + auth.uid).exists()"
        },
        "live": {
          ".write": "auth != null && root.child('rooms/' + $roomId + '/members/' + auth.uid).exists() && (!root.child('rooms/' + $roomId + '/control/uid').exists() || root.child('rooms/' + $roomId + '/control/uid').val() === auth.uid)"
        }
      }
    }
  }
}
